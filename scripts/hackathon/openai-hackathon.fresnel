{
  "$schema": "https://carstenartur.github.io/Fresnel/schemas/fresnel-job-v1.schema.json",
  "format": "io.github.carstenartur.fresnel.job",
  "formatVersion": 1,
  "plugin": {
    "id": "hologram",
    "parameterSchemaVersion": 1,
    "algorithmVersion": "hologram/1"
  },
  "parameters": {
    "targetImageBase64": "",
    "sidePx": 512,
    "iterations": 160,
    "outputType": "GREYSCALE_PHASE",
    "dpi": 1200.0,
    "wavelengthNm": 532.0,
    "refractiveIndexDelta": 0.5,
    "maxPhaseShiftRad": 6.283185307179586
  },
  "production": {
    "outputs": [
      {
        "id": "target-source",
        "format": "png",
        "filename": "openai-hackathon-target.png",
        "options": {
          "hologramPng": "SOURCE"
        }
      },
      {
        "id": "documentation-preview",
        "format": "png",
        "filename": "openai-hackathon-mask.png",
        "options": {
          "hologramPng": "MASK"
        }
      },
      {
        "id": "reconstruction-preview",
        "format": "png",
        "filename": "openai-hackathon-reconstruction.png",
        "options": {
          "hologramPng": "RECONSTRUCTION"
        }
      }
    ]
  },
  "provenance": {
    "createdWith": "Fresnel hackathon pitch",
    "applicationVersion": "development"
  }
}
